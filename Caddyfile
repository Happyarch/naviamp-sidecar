# Caddyfile for Navidrome + naviamp-sidecar
#
# Caddy listens on :4533 (Navidrome's conventional port) and routes by path:
#   /naviamp/*  →  naviamp-sidecar:8090   (delta sync, performing-artist browse)
#   everything  →  navidrome:4533          (standard OpenSubsonic API, streaming)
#
# The Naviamp client probes <serverUrl>/naviamp/capabilities on startup.
# Because Caddy is the only container with an exposed port, the client points
# at a single address and the sidecar is detected automatically — no separate
# port or URL needed.
#
# ── Port ─────────────────────────────────────────────────────────────────────
# :4533 keeps the same port users already have Navidrome on. Change it to
# :80 / :443 or your own port as needed; the routing logic is identical.
#
# ── handle vs handle_path ────────────────────────────────────────────────────
# `handle` preserves the full request path when proxying.
# `handle_path` strips the matched prefix before proxying.
#
# The sidecar's routes are registered as /naviamp/capabilities,
# /naviamp/changes, and /naviamp/artistTracks, so the /naviamp prefix must
# be preserved. Use `handle` here, not `handle_path`.

:4533 {
    # Route /naviamp/* to the sidecar, keeping the full path intact.
    handle /naviamp* {
        reverse_proxy naviamp-sidecar:8090
    }

    # Route everything else to Navidrome.
    handle /* {
        reverse_proxy navidrome:4533
    }
}

# ── Public domain with automatic HTTPS ───────────────────────────────────────
# Uncomment this block (and remove the :4533 block above) if you have a domain
# pointing at this server. Caddy provisions and renews a Let's Encrypt TLS
# certificate automatically — no certbot, no manual renewal.
#
# Replace "music.example.com" with your actual domain.
#
# music.example.com {
#     handle /naviamp* {
#         reverse_proxy naviamp-sidecar:8090
#     }
#
#     handle /* {
#         reverse_proxy navidrome:4533
#     }
# }
